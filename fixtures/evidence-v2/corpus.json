  "repositoryCases": [
    {
      "id": "delete-only",
      "baseFiles": {
        "src/legacy.ts": "export const legacy = true;\n"
      },
      "commits": [
        {
          "message": "refactor: remove legacy module",
          "operations": [
            {
              "kind": "delete",
              "path": "src/legacy.ts"
            }
          ]
        }
      ],
      "expected": {
        "nameStatus": [
          "D\tsrc/legacy.ts"
        ],
        "patchIncludes": [
          "-export const legacy = true;"
        ],
        "patchExcludes": []
      }
    },
    {
      "id": "rename",
      "baseFiles": {
        "src/old.ts": "export const value = 1;\n"
      },
      "commits": [
        {
          "message": "refactor: rename value module",
          "operations": [
            {
              "kind": "rename",
              "from": "src/old.ts",
              "path": "src/new.ts"
            }
          ]
        }
      ],
      "expected": {
        "nameStatus": [
          "R100\tsrc/old.ts\tsrc/new.ts"
        ],
        "patchIncludes": [
          "rename from src/old.ts",
          "rename to src/new.ts"
        ],
        "patchExcludes": []
      }
    },
    {
      "id": "revert-to-base",
      "baseFiles": {
        "config.txt": "timeout=30\n"
      },
      "commits": [
        {
          "message": "feat: increase timeout",
          "operations": [
            {
              "kind": "write",
              "path": "config.txt",
              "content": "timeout=60\n"
            }
          ]
        },
        {
          "message": "revert: restore timeout",
          "operations": [
            {
              "kind": "write",
              "path": "config.txt",
              "content": "timeout=30\n"
            }
          ]
        }
      ],
      "expected": {
        "nameStatus": [],
        "patchIncludes": [],
        "patchExcludes": [
          "timeout=60"
        ]
      }
    },
    {
      "id": "revert-then-replace",
      "baseFiles": {
        "config.txt": "timeout=30\n"
      },
      "commits": [
        {
          "message": "feat: increase timeout",
          "operations": [
            {
              "kind": "write",
              "path": "config.txt",
              "content": "timeout=60\n"
            }
          ]
        },
        {
          "message": "fix: choose bounded timeout",
          "operations": [
            {
              "kind": "write",
              "path": "config.txt",
              "content": "timeout=45\n"
            }
          ]
        }
      ],
      "expected": {
        "nameStatus": [
          "M\tconfig.txt"
        ],
        "patchIncludes": [
          "-timeout=30",
          "+timeout=45"
        ],
        "patchExcludes": [
          "timeout=60"
        ]
      }
    },
    {
      "id": "tests-changed-no-run",
      "baseFiles": {
        "src/value.ts": "export const value = 1;\n",
        "test/value.test.ts": "assert.equal(value, 1);\n"
      },
      "commits": [
        {
          "message": "test: cover the new value",
          "operations": [
            {
              "kind": "write",
              "path": "src/value.ts",
              "content": "export const value = 2;\n"
            },
            {
              "kind": "write",
              "path": "test/value.test.ts",
              "content": "assert.equal(value, 2);\n"
            }
          ]
        }
      ],
      "receipts": [],
      "expected": {
        "nameStatus": [
          "M\tsrc/value.ts",
          "M\ttest/value.test.ts"
        ],
        "patchIncludes": [
          "+export const value = 2;",
          "+assert.equal(value, 2);"
        ],
        "patchExcludes": [],
        "verificationClaims": []
      }
    }
  ],
