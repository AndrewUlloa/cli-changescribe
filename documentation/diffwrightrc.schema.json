{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/AndrewUlloa/diffwright/main/documentation/diffwrightrc.schema.json",
  "title": "Diffwright repository policy",
  "description": "Versioned, repository-local policy for Conventional Commit titles, advisory editorial checks, and bounded pull-request workflow preferences. Runtime validation also rejects duplicate JSON keys, invalid UTF-8, unsafe control or bidirectional characters, and case-insensitive duplicates where documented.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version"],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "version": {
      "enum": [1, 2]
    },
    "title": {
      "$ref": "#/$defs/titlePolicy"
    },
    "editorial": {
      "$ref": "#/$defs/editorialPolicy"
    },
    "pullRequest": {
      "$ref": "#/$defs/pullRequestPolicy"
    },
    "merge": {
      "$ref": "#/$defs/mergePolicy"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "version": {
            "const": 1
          }
        },
        "required": ["version"]
      },
      "then": {
        "not": {
          "anyOf": [
            { "required": ["pullRequest"] },
            { "required": ["merge"] }
          ]
        }
      }
    }
  ],
  "$defs": {
    "typeToken": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,31}$"
    },
    "scopeToken": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._/-]{0,63}$"
    },
    "boundedTerm": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "titlePolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "additionalTypes": {
          "description": "Additional Conventional Commit types. Values must be unique and must not duplicate the built-in standard types.",
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/typeToken"
          },
          "not": {
            "contains": {
              "enum": [
                "build",
                "chore",
                "ci",
                "docs",
                "feat",
                "fix",
                "perf",
                "refactor",
                "revert",
                "style",
                "test"
              ]
            }
          }
        },
        "scopeMode": {
          "enum": ["optional", "forbidden"]
        },
        "allowedScopes": {
          "description": "Optional allowlist for generated scopes. Values must be unique.",
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/scopeToken"
          }
        },
        "targetLength": {
          "description": "Advisory title-length target from 1 through 72 characters. The immutable hard maximum remains 72 characters.",
          "type": "integer",
          "minimum": 1,
          "maximum": 72
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "scopeMode": {
                "const": "forbidden"
              }
            },
            "required": ["scopeMode"]
          },
          "then": {
            "not": {
              "required": ["allowedScopes"]
            }
          }
        }
      ]
    },
    "terminologyGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "terms"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "terms": {
          "description": "Terms are compared case-insensitively at runtime.",
          "type": "array",
          "minItems": 2,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/boundedTerm"
          }
        }
      }
    },
    "editorialPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxSentenceWords": {
          "type": "integer",
          "minimum": 5,
          "maximum": 100
        },
        "duplicateClaimMinWords": {
          "type": "integer",
          "minimum": 2,
          "maximum": 100
        },
        "vagueAbsolutes": {
          "description": "Literal advisory terms. Values are compared case-insensitively at runtime.",
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/boundedTerm"
          }
        },
        "terminologyGroups": {
          "description": "Group names are unique case-insensitively at runtime.",
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/terminologyGroup"
          }
        }
      }
    },
    "pullRequestPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "issueContext": {
          "description": "Whether linked issue context is optional, recommended, or required before pull-request generation.",
          "enum": ["optional", "recommended", "required"]
        },
        "template": {
          "description": "Create Diffwright's managed pull-request template only when none exists, or preserve template state without creating one.",
          "enum": ["create", "preserve"]
        }
      }
    },
    "mergePolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "strategy": {
          "description": "Use Diffwright's validated squash path or leave merging to the hosting platform.",
          "enum": ["squash", "platform"]
        },
        "deleteBranch": {
          "description": "Delete the feature branch only after Diffwright confirms a successful squash merge.",
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "strategy": {
                "const": "platform"
              }
            },
            "required": ["strategy"]
          },
          "then": {
            "properties": {
              "deleteBranch": {
                "const": false
              }
            }
          }
        }
      ]
    }
  }
}
