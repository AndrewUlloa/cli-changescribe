{
  "name": "diffwright",
  "version": "0.2.2",
  "description": "Turn Git diffs into Conventional Commit messages and PR summaries",
  "bin": {
    "diffwright": "bin/diffwright.js"
  },
  "scripts": {
    "clean": "node -e \"const fs=require('node:fs'); for (const dir of ['dist','.test-dist']) fs.rmSync(dir,{recursive:true,force:true})\"",
    "prebuild": "npm run clean",
    "build": "tsc -p tsconfig.json",
    "prebuild:test": "node -e \"require('node:fs').rmSync('.test-dist',{recursive:true,force:true})\"",
    "build:test": "tsc -p tsconfig.test.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "npm run build && npm run build:test && node .test-dist/run-tests.js",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test",
    "commit": "diffwright commit",
    "pr:summary": "diffwright pr:summary",
    "feature:pr": "diffwright feature:pr",
    "staging:pr": "diffwright staging:pr"
  },
  "type": "commonjs",
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "cli",
    "git",
    "diff",
    "commit",
    "conventional-commits",
    "pr",
    "summary",
    "changelog",
    "groq",
    "cerebras",
    "openai"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AndrewUlloa/diffwright.git"
  },
  "homepage": "https://github.com/AndrewUlloa/diffwright#readme",
  "bugs": {
    "url": "https://github.com/AndrewUlloa/diffwright/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "dotenv": "^17.2.1",
    "openai": "^4.104.0"
  },
  "devDependencies": {
    "@types/node": "^18.19.130",
    "typescript": "^5.9.3"
  }
}
