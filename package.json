{
  "name": "diffwright",
  "version": "0.2.1",
  "description": "Turn Git diffs into Conventional Commit messages and PR summaries",
  "bin": {
    "diffwright": "bin/diffwright.js"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "commit": "diffwright commit",
    "pr:summary": "diffwright pr:summary",
    "feature:pr": "diffwright feature:pr",
    "staging:pr": "diffwright staging:pr"
  },
  "type": "commonjs",
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "cli",
    "git",
    "diff",
    "commit",
    "conventional-commits",
    "pr",
    "summary",
    "changelog",
    "groq",
    "cerebras",
    "openai"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "dotenv": "^17.2.1",
    "openai": "^4.104.0"
  }
}
